# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb+srv://your_db_username:your_db_password@your_cluster.mongodb.net/?appName=Cluster0

# JWT Configuration
# Generate these secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRE=30d

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=Polyglot Scribe <your_email@gmail.com>

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:8080

# Backend public URL (used for Chapa webhook callback_url)
# IMPORTANT: In production, set this to your deployed backend URL (e.g. https://api.yourapp.com)
API_BASE_URL=http://localhost:5000

# OTP Configuration
OTP_EXPIRE_MINUTES=60
OTP_LENGTH=6

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Chapa Payment Gateway
# Get your keys from: https://dashboard.chapa.co/
CHAPA_SECRET_KEY=your_chapa_secret_key_here

# e-Birr Payment Gateway
EBIRR_API_URL=https://api.ebirr.com
EBIRR_API_KEY=your_ebirr_api_key_here
EBIRR_MERCHANT_ID=your_ebirr_merchant_id_here

# Google OAuth (REQUIRED for "Continue with Google" to work)
# Get credentials from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
