# Server Configuration
PORT=5000
NODE_ENV=development
#MongoDB_PASSWORD=hYJynlwHTvF5VW8G
# MongoDB Configuration
# Option 1: Local MongoDB (if you have MongoDB installed locally)
MONGODB_URI=

# Option 2: MongoDB Atlas (Cloud - Recommended)
# Uncomment the line below and replace with your Atlas connection string
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/polyglot-scribe?retryWrites=true&w=majority

# JWT Configuration
# Generate these secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=30d

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Polyglot Scribe <mulukenugamo7@gmail.com>

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:8080

# OTP Configuration
OTP_EXPIRE_MINUTES=60
OTP_LENGTH=6

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Chapa Payment Gateway
# Get your keys from: https://dashboard.chapa.co/
CHAPA_SECRET_KEY=

# e-Birr Payment Gateway
EBIRR_API_URL=https://api.ebirr.com
EBIRR_API_KEY=your_ebirr_api_key_here
EBIRR_MERCHANT_ID=your_ebirr_merchant_id_here

# Google OAuth (REQUIRED for "Continue with Google" to work)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
